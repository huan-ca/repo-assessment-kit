{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-assessment-kit.invalid/schemas/rak-agent-proposal/1.0.0",
  "title": "RAK provider proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaId",
    "taskId",
    "runId",
    "attemptId",
    "fenceToken",
    "evidenceOccurrenceIds",
    "limitationIds",
    "content"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "schemaId": { "const": "rak-agent-proposal/1.0.0" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "attemptId": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "fenceToken": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
    "evidenceOccurrenceIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10000,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "limitationIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 1000,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "content": {
      "oneOf": [{ "$ref": "#/$defs/authorContent" }, { "$ref": "#/$defs/reviewerContent" }]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "boundedId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/boundedId" }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "controlId", "result", "evidenceOccurrenceIds", "summary"],
      "properties": {
        "claimId": { "$ref": "#/$defs/boundedId" },
        "controlId": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9._/-]{0,127}$"
        },
        "result": {
          "enum": ["pass", "fail", "partial", "blocked", "not-applicable", "not-tested"]
        },
        "evidenceOccurrenceIds": {
          "$ref": "#/$defs/evidenceIds",
          "minItems": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limitationId", "code", "evidenceOccurrenceIds"],
      "properties": {
        "limitationId": { "$ref": "#/$defs/boundedId" },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "evidenceOccurrenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "authorContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "limitations"],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/claim" }
        },
        "limitations": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/limitation" }
        }
      }
    },
    "reviewerContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorProposalDigest", "verdict", "objectionCodes", "evidenceOccurrenceIds"],
      "properties": {
        "authorProposalDigest": { "$ref": "#/$defs/digest" },
        "verdict": {
          "enum": ["passed", "passed-with-objections", "failed"]
        },
        "objectionCodes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/boundedId" }
        },
        "evidenceOccurrenceIds": {
          "$ref": "#/$defs/evidenceIds",
          "minItems": 1
        }
      }
    }
  }
}
