{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repo-assessment-kit.dev/rak/1.0/repository-assessment.schema.json",
  "title": "Repository Assessment Kit repository assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "runId",
    "snapshotId",
    "generatedAt",
    "ecosystems",
    "primaryEcosystem",
    "reducedDepth",
    "files",
    "composition",
    "stackSignals",
    "architectureSignals",
    "maintainabilitySignals",
    "runtimeReadiness",
    "securityProfileSignals",
    "featureCatalog",
    "dependencies",
    "findings",
    "evidence",
    "tools",
    "coverage",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "profile": { "const": "rak-contract/1.0.0" },
    "runId": { "$ref": "#/$defs/nonEmpty" },
    "snapshotId": { "$ref": "#/$defs/nonEmpty" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "ecosystems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ecosystem" }
    },
    "primaryEcosystem": { "$ref": "#/$defs/ecosystem" },
    "reducedDepth": { "type": "boolean" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repoRelPath", "byteLength", "extension", "classification"],
        "properties": {
          "repoRelPath": { "$ref": "#/$defs/repoPath" },
          "byteLength": { "type": "integer", "minimum": 0 },
          "extension": { "type": "string" },
          "classification": {
            "enum": ["text", "binary", "symlink", "excluded"]
          },
          "exclusionReason": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesInspected",
        "textFilesInspected",
        "bytesInspected",
        "extensions",
        "exclusions"
      ],
      "properties": {
        "filesInspected": { "type": "integer", "minimum": 0 },
        "textFilesInspected": { "type": "integer", "minimum": 0 },
        "bytesInspected": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "extensions": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "exclusions": { "$ref": "#/$defs/strings" }
      }
    },
    "stackSignals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ecosystem", "signal", "repoRelPath", "confidence"],
        "properties": {
          "ecosystem": { "$ref": "#/$defs/ecosystem" },
          "signal": { "$ref": "#/$defs/nonEmpty" },
          "repoRelPath": { "$ref": "#/$defs/repoPath" },
          "confidence": { "$ref": "#/$defs/confidence" }
        }
      }
    },
    "architectureSignals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boundary", "repoRelPath", "provenance", "limitation"],
        "properties": {
          "boundary": { "$ref": "#/$defs/nonEmpty" },
          "repoRelPath": { "$ref": "#/$defs/repoPath" },
          "provenance": { "enum": ["observed", "code-inferred"] },
          "limitation": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "maintainabilitySignals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "value", "interpretation", "limitation"],
        "properties": {
          "signal": { "$ref": "#/$defs/nonEmpty" },
          "value": { "type": "string" },
          "interpretation": { "$ref": "#/$defs/nonEmpty" },
          "limitation": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "runtimeReadiness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signal", "status", "limitation"],
        "properties": {
          "signal": { "$ref": "#/$defs/nonEmpty" },
          "repoRelPath": { "$ref": "#/$defs/repoPath" },
          "status": { "enum": ["observed", "absent", "unknown"] },
          "limitation": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "securityProfileSignals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/securityProfile" }
    },
    "featureCatalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "featureId",
          "name",
          "kind",
          "provenance",
          "repoRelPath",
          "confidence",
          "evidenceOccurrenceIds",
          "limitations"
        ],
        "properties": {
          "featureId": { "$ref": "#/$defs/nonEmpty" },
          "name": { "$ref": "#/$defs/nonEmpty" },
          "kind": { "enum": ["route", "documented-capability", "entrypoint"] },
          "provenance": { "enum": ["documented", "code-inferred"] },
          "repoRelPath": { "$ref": "#/$defs/repoPath" },
          "line": { "type": "integer", "minimum": 1 },
          "confidence": { "enum": ["medium", "low"] },
          "evidenceOccurrenceIds": { "$ref": "#/$defs/strings" },
          "limitations": { "$ref": "#/$defs/strings" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bomRef", "purl", "ecosystem", "name", "scope", "repoRelPath"],
        "properties": {
          "bomRef": { "$ref": "#/$defs/nonEmpty" },
          "purl": { "type": "string", "pattern": "^pkg:" },
          "ecosystem": { "$ref": "#/$defs/ecosystem" },
          "name": { "$ref": "#/$defs/nonEmpty" },
          "version": { "$ref": "#/$defs/nonEmpty" },
          "scope": { "enum": ["required", "development", "unknown"] },
          "repoRelPath": { "$ref": "#/$defs/repoPath" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/toolExecution" }
    },
    "coverage": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/domainCoverage" }
    },
    "limitations": { "$ref": "#/$defs/strings" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "strings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "ecosystem": {
      "enum": ["node", "python", "go", "java", "dotnet", "ruby", "php", "generic"]
    },
    "confidence": { "enum": ["high", "medium", "low"] },
    "coverageStatus": {
      "enum": ["pass", "fail", "partial", "blocked", "not applicable", "not tested"]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "partial", "blocked", "not applicable", "not tested"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "not applicable": { "type": "integer", "minimum": 0 },
        "not tested": { "type": "integer", "minimum": 0 }
      }
    },
    "securityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "kind",
        "application",
        "state",
        "customerConfirmationRequired",
        "customerConfirmed",
        "trigger",
        "evidenceOccurrenceIds",
        "controls",
        "coverage",
        "limitation"
      ],
      "properties": {
        "profileId": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["baseline", "selected-overlay", "overlay-recommendation"] },
        "application": {
          "enum": ["always-applied", "operator-selected", "recommended-only"]
        },
        "state": { "enum": ["applied-reduced-depth", "recommended-not-confirmed"] },
        "customerConfirmationRequired": { "type": "boolean" },
        "customerConfirmed": { "type": "boolean" },
        "confirmationReference": { "$ref": "#/$defs/nonEmpty" },
        "trigger": { "$ref": "#/$defs/nonEmpty" },
        "evidenceOccurrenceIds": { "$ref": "#/$defs/strings" },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["controlId", "status", "reasonCode", "reason", "evidenceOccurrenceIds"],
            "properties": {
              "controlId": { "$ref": "#/$defs/nonEmpty" },
              "status": { "enum": ["partial", "blocked", "not tested"] },
              "reasonCode": { "$ref": "#/$defs/nonEmpty" },
              "reason": { "$ref": "#/$defs/nonEmpty" },
              "evidenceOccurrenceIds": { "$ref": "#/$defs/strings" }
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "plannedControls", "reconciledControls", "counts"],
          "properties": {
            "status": { "enum": ["partial", "blocked", "not tested"] },
            "plannedControls": { "type": "integer", "minimum": 0 },
            "reconciledControls": { "type": "integer", "minimum": 0 },
            "counts": { "$ref": "#/$defs/counts" }
          }
        },
        "limitation": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "findingId",
        "runId",
        "fingerprint",
        "revision",
        "title",
        "description",
        "category",
        "technicalSeverity",
        "businessPriority",
        "confidence",
        "validationState",
        "evidenceOccurrenceIds",
        "locations",
        "cweMappings",
        "cvss",
        "ruleId"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "findingId": { "$ref": "#/$defs/nonEmpty" },
        "runId": { "$ref": "#/$defs/nonEmpty" },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "rak-finding/v1" },
            "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "revision": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "description": { "$ref": "#/$defs/nonEmpty" },
        "category": { "$ref": "#/$defs/nonEmpty" },
        "technicalSeverity": {
          "enum": ["critical", "high", "medium", "low", "informational"]
        },
        "businessPriority": { "const": "unassigned" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "validationState": { "const": "unreviewed" },
        "evidenceOccurrenceIds": { "$ref": "#/$defs/strings" },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repoRelPath"],
            "properties": {
              "repoRelPath": { "$ref": "#/$defs/repoPath" },
              "startLine": { "type": "integer", "minimum": 1 },
              "endLine": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "cweMappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cweId", "catalogVersion", "primary", "method", "confidence"],
            "properties": {
              "cweId": { "type": "string", "pattern": "^CWE-[1-9][0-9]*$" },
              "catalogVersion": { "const": "4.20" },
              "primary": { "const": true },
              "method": { "const": "tool" },
              "confidence": { "enum": ["medium", "low"] }
            }
          }
        },
        "cvss": { "type": "array", "maxItems": 0 },
        "ruleId": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "evidenceType",
        "title",
        "repoRelPath",
        "safeExcerpt",
        "sensitivity",
        "redactionState",
        "collectionLimitations"
      ],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/nonEmpty" },
        "evidenceType": { "$ref": "#/$defs/nonEmpty" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "repoRelPath": { "$ref": "#/$defs/repoPath" },
        "startLine": { "type": "integer", "minimum": 1 },
        "safeExcerpt": { "type": "string" },
        "sensitivity": {
          "enum": ["public", "customer-confidential", "secret-suspected", "restricted"]
        },
        "redactionState": { "enum": ["none-required", "redacted", "excluded"] },
        "collectionLimitations": { "$ref": "#/$defs/strings" }
      }
    },
    "toolExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolId",
        "displayName",
        "availability",
        "invocation",
        "outcome",
        "networkUsed",
        "targetCodeExecuted"
      ],
      "properties": {
        "toolId": { "$ref": "#/$defs/nonEmpty" },
        "displayName": { "$ref": "#/$defs/nonEmpty" },
        "availability": { "enum": ["available", "unavailable", "not-configured"] },
        "invocation": { "enum": ["invoked", "not-invoked"] },
        "outcome": { "enum": ["succeeded", "failed", "not-run"] },
        "reasonCode": { "$ref": "#/$defs/nonEmpty" },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "networkUsed": { "const": false },
        "targetCodeExecuted": { "const": false }
      }
    },
    "domainCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "coverageId",
        "runId",
        "domainId",
        "status",
        "plannedControls",
        "reconciledControls",
        "counts",
        "exclusions",
        "unsupportedEcosystems",
        "limitationIds",
        "evidenceOccurrenceIds"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "coverageId": { "$ref": "#/$defs/nonEmpty" },
        "runId": { "$ref": "#/$defs/nonEmpty" },
        "domainId": {
          "enum": [
            "repository-composition",
            "stack-detection",
            "architecture-boundaries",
            "engineering-maintainability",
            "features-use-cases",
            "dependency-inventory",
            "dependency-vulnerabilities",
            "secret-detection",
            "sast",
            "iac-container-license",
            "runtime-readiness",
            "dynamic-browser-security",
            "security-independent-review",
            "modernization-decision",
            "evidence-package-integrity"
          ]
        },
        "status": { "$ref": "#/$defs/coverageStatus" },
        "plannedControls": { "type": "integer", "minimum": 0 },
        "reconciledControls": { "type": "integer", "minimum": 0 },
        "counts": { "$ref": "#/$defs/counts" },
        "exclusions": { "$ref": "#/$defs/strings" },
        "unsupportedEcosystems": { "$ref": "#/$defs/strings" },
        "limitationIds": { "$ref": "#/$defs/strings" },
        "evidenceOccurrenceIds": { "$ref": "#/$defs/strings" }
      }
    }
  }
}
