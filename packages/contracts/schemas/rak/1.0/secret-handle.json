{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rak.local/schemas/rak/1.0/secret-handle.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["secretHandleId", "purpose", "recipient", "expiresAt", "uploaded", "remainingUses"],
  "properties": {
    "secretHandleId": { "type": "string" },
    "purpose": { "type": "string" },
    "recipient": { "type": "string" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "uploaded": { "type": "boolean" },
    "remainingUses": { "enum": [0, 1] }
  }
}
