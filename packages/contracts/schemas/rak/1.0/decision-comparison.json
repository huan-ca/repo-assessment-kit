{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rak.local/schemas/rak/1.0/decision-comparison.json",
  "title": "DecisionComparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "criteria",
    "recommendation",
    "rationale",
    "confidence",
    "assumptions",
    "dependencies",
    "reversalConditions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "criteria": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "options"],
        "properties": {
          "criterion": {
            "enum": [
              "recoverability",
              "system-boundaries",
              "security-risk",
              "engineering-risk",
              "critical-feature-parity",
              "expected-scale",
              "rebuild-feasibility"
            ]
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "required": ["remediation", "incremental-replacement", "full-rebuild"],
            "properties": {
              "remediation": { "$ref": "#/$defs/option" },
              "incremental-replacement": { "$ref": "#/$defs/option" },
              "full-rebuild": { "$ref": "#/$defs/option" }
            }
          }
        }
      }
    },
    "recommendation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "option"],
          "properties": {
            "kind": { "const": "single" },
            "option": { "$ref": "#/$defs/pathOption" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "options"],
          "properties": {
            "kind": { "const": "conditional-sequence" },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/pathOption" }
            }
          }
        }
      ]
    },
    "rationale": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["high", "medium", "low"] },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "reversalConditions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "pathOption": { "enum": ["remediation", "incremental-replacement", "full-rebuild"] },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment", "state", "confidence", "claimIds", "evidenceOccurrenceIds"],
      "properties": {
        "assessment": { "type": "string", "minLength": 1 },
        "state": { "enum": ["evidenced", "unverified", "conflicting"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "claimIds": { "type": "array", "items": { "type": "string" } },
        "evidenceOccurrenceIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
