{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-assessment-kit.invalid/schemas/rak-signed-customer-release-authorization/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "equivalencePairId",
    "successorZipDigest",
    "reconciliationDigest",
    "inputBindingDigest",
    "reviewDigests",
    "certificates",
    "decision",
    "issuedAt",
    "expiresAt",
    "nonce",
    "signingKeyId",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "rak-signed-customer-release-authorization/1.0.0" },
    "recordId": { "$ref": "#/$defs/id" },
    "equivalencePairId": { "$ref": "#/$defs/id" },
    "successorZipDigest": { "$ref": "#/$defs/digest" },
    "reconciliationDigest": { "$ref": "#/$defs/digest" },
    "inputBindingDigest": { "$ref": "#/$defs/digest" },
    "reviewDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent-security",
        "independent-decision",
        "technical-human",
        "lay-human",
        "customer-acceptance"
      ],
      "properties": {
        "independent-security": { "$ref": "#/$defs/digest" },
        "independent-decision": { "$ref": "#/$defs/digest" },
        "technical-human": { "$ref": "#/$defs/digest" },
        "lay-human": { "$ref": "#/$defs/digest" },
        "customer-acceptance": { "$ref": "#/$defs/digest" }
      }
    },
    "certificates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseAssets",
        "toolchain",
        "images",
        "sbom",
        "provenance",
        "vulnerability",
        "officialSchemas",
        "platforms",
        "providerCanaries",
        "providerEquivalence",
        "ssh",
        "cleanupReceipts"
      ],
      "properties": {
        "releaseAssets": { "$ref": "#/$defs/certificate" },
        "toolchain": { "$ref": "#/$defs/certificate" },
        "images": { "$ref": "#/$defs/certificate" },
        "sbom": { "$ref": "#/$defs/certificate" },
        "provenance": { "$ref": "#/$defs/certificate" },
        "vulnerability": { "$ref": "#/$defs/certificate" },
        "officialSchemas": { "$ref": "#/$defs/certificate" },
        "platforms": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/certificate" }
        },
        "providerCanaries": { "$ref": "#/$defs/certificate" },
        "providerEquivalence": { "$ref": "#/$defs/certificate" },
        "ssh": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/certificate" }] },
        "cleanupReceipts": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/certificate" }
        }
      }
    },
    "decision": { "enum": ["approved", "rejected"] },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,256}$" },
    "signingKeyId": { "$ref": "#/$defs/id" },
    "signature": { "type": "string", "minLength": 80, "maxLength": 128 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "certificateId",
        "kind",
        "equivalencePairId",
        "subjectDigest",
        "decision",
        "issuedAt",
        "expiresAt",
        "nonce",
        "signingKeyId",
        "signature"
      ],
      "properties": {
        "schemaVersion": { "const": "rak-signed-release-certificate/1.0.0" },
        "certificateId": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/id" },
        "equivalencePairId": { "$ref": "#/$defs/id" },
        "subjectDigest": { "$ref": "#/$defs/digest" },
        "decision": { "const": "approved" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,256}$" },
        "signingKeyId": { "$ref": "#/$defs/id" },
        "signature": { "type": "string", "minLength": 80, "maxLength": 128 }
      }
    }
  }
}
