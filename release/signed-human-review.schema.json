{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repo-assessment-kit.invalid/schemas/rak-signed-human-review/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "kind",
    "reviewerId",
    "organizationId",
    "independenceDeclaration",
    "equivalencePairId",
    "successorZipDigest",
    "reconciliationDigest",
    "inputBindingDigest",
    "decision",
    "limitationIds",
    "issuedAt",
    "expiresAt",
    "nonce",
    "signingKeyId",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "rak-signed-human-review/1.0.0" },
    "recordId": { "$ref": "#/$defs/id" },
    "kind": {
      "enum": [
        "independent-security",
        "independent-decision",
        "technical-human",
        "lay-human",
        "customer-acceptance"
      ]
    },
    "reviewerId": { "$ref": "#/$defs/id" },
    "organizationId": { "$ref": "#/$defs/id" },
    "independenceDeclaration": { "type": "string", "minLength": 8, "maxLength": 1024 },
    "equivalencePairId": { "$ref": "#/$defs/id" },
    "successorZipDigest": { "$ref": "#/$defs/digest" },
    "reconciliationDigest": { "$ref": "#/$defs/digest" },
    "inputBindingDigest": { "$ref": "#/$defs/digest" },
    "decision": { "enum": ["approved", "rejected"] },
    "limitationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,256}$" },
    "signingKeyId": { "$ref": "#/$defs/id" },
    "signature": { "type": "string", "minLength": 80, "maxLength": 128 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
