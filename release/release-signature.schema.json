{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.repo-assessment-kit.dev/release/signature/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "keyId", "algorithm", "payload", "signature"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "profile": { "const": "rak-release-signature/1.0.0" },
    "keyId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "algorithm": { "const": "Ed25519" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "manifestSha256", "toolchainLockSha256"],
      "properties": {
        "profile": { "const": "rak-release-authority/1.0.0" },
        "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "toolchainLockSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "signature": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 88,
      "maxLength": 88
    }
  }
}
