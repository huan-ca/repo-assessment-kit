{
  "name": "repo-assessment-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven repository assessment control plane",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.4.1",
    "pnpm": "11.17.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present run clean",
    "dev": "concurrently --kill-others-on-fail --names server,web \"pnpm --filter @rak/server dev\" \"pnpm --filter @rak/web dev\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"{scripts,container}/*.mjs\" \"*.config.{js,mjs,ts}\" --max-warnings 0 && pnpm boundaries",
    "boundaries": "node scripts/check-workspace-boundaries.mjs",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run && pnpm test:release-seams",
    "test:release-seams": "node --test container/provider-task.test.mjs container/runtime/install/installer-static.test.mjs scripts/host-helper-protocol.test.mjs scripts/provider-broker.test.mjs scripts/immutable-local-snapshot.test.mjs scripts/production-installation-config.test.mjs scripts/provider-successor-package.test.mjs scripts/production-ssh-source.test.mjs scripts/production-runtime-flow.test.mjs scripts/verify-release-assets.test.mjs && node scripts/runtime-launcher-smoke.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs && node scripts/security-smoke.mjs",
    "shell:check": "bash -n start-code.sh start-codex.sh start-cc.sh scripts/*.sh",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm fixtures:verify && pnpm shell:check && pnpm build && pnpm smoke",
    "db:generate": "pnpm --filter @rak/persistence db:generate",
    "db:migrate": "pnpm --filter @rak/persistence db:migrate",
    "fixtures:verify": "node scripts/verify-fixtures.mjs",
    "assessment:offline": "node scripts/run-offline-assessment.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@playwright/test": "1.54.1",
    "@types/node": "24.1.0",
    "@vitest/coverage-v8": "3.2.4",
    "concurrently": "9.2.0",
    "eslint": "9.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0",
    "vite": "8.0.0",
    "vitest": "3.2.4"
  }
}
