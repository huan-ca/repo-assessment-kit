# Copy to .env for operator-local, non-secret settings. Never place provider or target secrets here.
RAK_UI_PORT=4173
RAK_INTERNAL_PORT=3000
RAK_ENGAGEMENT_ID=replace-with-unique-engagement-slug
RAK_PROJECT_SLUG=assessment

# Provider login networking is unavailable unless an external egress controller creates
# the named Docker network and a matching unexpired attestation.
# RAK_PROVIDER_NETWORK=rak-provider-egress
# RAK_PROVIDER_EGRESS_ATTESTATION=/absolute/path/to/provider-network-attestation.json
# RAK_PROVIDER_NETWORK_NONCE=<64-lowercase-hex issued for this one login>

# SSH acquisition has a distinct network and attestation. Source acquisition arguments,
# exact private-key path, and exact known_hosts path are command arguments to
# scripts/acquire-source.sh; they are never mounted into a provider container.
# RAK_GIT_NETWORK=rak-git-egress
# RAK_GIT_EGRESS_ATTESTATION=/absolute/path/to/git-network-attestation.json
# RAK_GIT_NETWORK_NONCE=<64-lowercase-hex issued for this one acquisition>

# Native runtime gates address one disposable instance with this constrained name.
# RAK_RUNTIME_INSTANCE=rak-runtime-engagement

# Provider credentials belong only in the provider-specific persistent home established by
# the login verb. The launcher does not forward credential environment variables.
